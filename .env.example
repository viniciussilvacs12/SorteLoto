# Banco de dados
POSTGRES_DB=smartloto
POSTGRES_USER=smartloto
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# JWT (mínimo 32 caracteres)
SMARTLOTO_JWT_SECRET=troque-por-uma-chave-jwt-longa-e-aleatoria-com-32-ou-mais-caracteres
SMARTLOTO_JWT_EXPIRATION_MINUTES=120

# Administrador local (opcional)
SMARTLOTO_ADMIN_ENABLED=false
SMARTLOTO_ADMIN_EMAIL=admin@smartloto.local
SMARTLOTO_ADMIN_PASSWORD=troque-por-uma-senha-forte
SMARTLOTO_ADMIN_SYNC_ON_START=false

# Google Login (opcional)
# Configure um OAuth Client ID do tipo Web e adicione http://localhost:8088
# em Authorized JavaScript origins.
GOOGLE_CLIENT_ID=
